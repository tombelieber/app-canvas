{
  "name": "app-canvas-services",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "observability": {"enabled": false},
  "vars": {"RELEASE_VERSION": "0.13.1"},
  "d1_databases": [{"binding": "DB", "database_name": "app-canvas-waitlist", "database_id": "0d245e36-77a3-4648-9bea-b1a89808cb6b", "migrations_dir": "migrations"}],
  "ratelimits": [
    {"name": "WAITLIST_LIMIT", "namespace_id": "71001", "simple": {"limit": 8, "period": 60}},
    {"name": "EVENT_LIMIT", "namespace_id": "71002", "simple": {"limit": 90, "period": 60}}
  ],
  "triggers": {"crons": ["19 3 * * *"]}
}
