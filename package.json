{
  "name": "@tombelieber/app-canvas",
  "version": "0.15.0",
  "description": "An interactive overview of real application screens, states and flows.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tombelieber/app-canvas"
  },
  "bin": {
    "app-canvas": "bin/app-canvas.mjs"
  },
  "exports": {
    ".": "./lib/server.mjs",
    "./preview": "./lib/preview.js",
    "./inventory": "./lib/inventory.mjs",
    "./routes": "./lib/routes.mjs",
    "./import": "./lib/import/agent.mjs",
    "./population": "./lib/populate.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "ui/",
    "skills/",
    "examples/",
    ".claude-plugin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/*.png",
    "docs/*.jpg",
    "docs/*.md",
    "docs/ui-delivery-benchmark.json",
    "AGENT_GUIDE.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "docs:generate": "node scripts/build-launch.mjs --readmes-only",
    "check:locales": "node scripts/build-launch.mjs --check",
    "test:launch": "node tests/launch.browser.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:import": "node tests/import-capture.browser.mjs && node tests/import-editor.browser.mjs && node tests/import.browser.mjs && node tests/import-agent.browser.mjs",
    "test:browser": "node tests/browser.mjs",
    "demo": "node bin/app-canvas.mjs --config examples/stoolsense/canvas.config.mjs",
    "pack:check": "npm pack --dry-run --json",
    "release:pack": "node scripts/package-release.mjs",
    "test:layout": "node tests/wide.browser.mjs",
    "test:watch": "node tests/watch.browser.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "test:static": "node tests/static.browser.mjs",
    "test:onboarding": "node tests/onboarding.browser.mjs",
    "test:population": "node tests/population.browser.mjs",
    "check:privacy": "node scripts/privacy-check.mjs",
    "test:navigation": "node tests/navigation.browser.mjs",
    "test:journeys": "node tests/journey.browser.mjs",
    "test:demo": "node tests/demo.browser.mjs",
    "test:demo-controls": "node tests/demo-controls.browser.mjs",
    "test:live": "node tests/live.browser.mjs",
    "test:height": "node tests/height.browser.mjs",
    "test:queue": "node tests/queue.browser.mjs",
    "test:all-cases": "node tests/all-cases.browser.mjs",
    "test:file": "node tests/file.browser.mjs",
    "test:touch": "node tests/workbench.browser.mjs",
    "test:tablet": "node tests/tablet.browser.mjs",
    "test:zoom": "node tests/zoom.browser.mjs",
    "test:legacy": "node tests/legacy.browser.mjs",
    "test:dom": "node tests/dom-preview.browser.mjs",
    "test:shared": "node tests/shared-preview.browser.mjs",
    "test:native-overview": "node tests/native-overview.browser.mjs",
    "test:overview-budget": "node tests/overview-budget.browser.mjs",
    "test:readiness": "node tests/readiness.browser.mjs",
    "test:i18n": "node tests/i18n.browser.mjs",
    "test:telemetry": "node tests/telemetry.browser.mjs",
    "test:waitlist": "node tests/waitlist-runtime.mjs",
    "test:grouping": "node tests/grouping.browser.mjs",
    "test:review": "node tests/review.browser.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xyflow/react": "^12.12.0",
    "css-tree": "3.2.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9.3"
  }
}
