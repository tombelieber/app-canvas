    { "id": "tasks-empty", "group": "tasks", "title": "Tasks / empty", "path": "/", "source": "src/App.jsx:Tasks", "ready": "[data-state=empty]" },
    { "id": "tasks-loading", "group": "tasks", "title": "Tasks / loading", "path": "/", "source": "src/App.jsx:Tasks", "ready": "[data-state=loading]" },
    { "id": "tasks-error", "group": "tasks", "title": "Tasks / failed then retry", "path": "/", "source": "src/App.jsx:Tasks", "ready": "[data-state=error]" },
    { "id": "settings", "group": "settings", "title": "Settings / editable", "path": "/settings", "pattern": "/settings", "source": "src/App.jsx:Settings", "ready": "[data-state=settings]" },
    { "id": "settings-denied", "group": "settings", "title": "Settings / access denied", "path": "/settings", "source": "src/App.jsx:Settings", "ready": "[data-state=denied]" }
